# Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Superuser (Local Docker only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dummy_super_password
POSTGRES_DB=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Database Roles (5 roles required)
SHD_MIGRATOR_PASSWORD=dummy_migrator_password_123456
SHD_APP_PASSWORD=dummy_app_password_123456
SHD_GRADER_PASSWORD=dummy_grader_password_123456
SHD_WORKER_PASSWORD=dummy_worker_password_123456
SHD_READONLY_PASSWORD=dummy_readonly_password_123456

# Connection Strings
DATABASE_URL=postgresql://shd_app:dummy_app_password_123456@127.0.0.1:5432/shd_tuhoctiengduc
TEST_DATABASE_URL=postgresql://shd_migrator:dummy_migrator_password_123456@127.0.0.1:5432/shd_test
MIGRATOR_DATABASE_URL=postgresql://shd_migrator:dummy_migrator_password_123456@127.0.0.1:5432/shd_tuhoctiengduc
GRADER_DATABASE_URL=postgresql://shd_grader:dummy_grader_password_123456@127.0.0.1:5432/shd_tuhoctiengduc

# Security Hashes (32 bytes hex)
PHONE_HASH_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OTP_HASH_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
